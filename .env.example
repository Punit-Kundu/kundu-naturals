# Groq chatbot (keep the API key server-side; never add a real key to client/.env)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# SMTP Configuration (for email sending)
# Get these from your email provider (Gmail, Outlook, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
