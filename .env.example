# Kundu Naturals - Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Business Information (Public)
BUSINESS_PHONE=9034677123
BUSINESS_EMAIL=kundupunit927@gmail.com
BUSINESS_ADDRESS=Kundu Naturals, Village Kailram, District Kaithal, Haryana, India
WHATSAPP_NUMBER=919034677123
